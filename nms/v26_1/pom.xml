        </dependency>
        <dependency>
            <groupId>fr.euphyllia.skyllia</groupId>
            <artifactId>skyllia-nms-v1_21_R7</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Paper dev bundle 26.1.2 - requires paperweight-generated server JAR -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-server</artifactId>
            <version>26.1.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>net.kyori</groupId>
                    <artifactId>adventure-text-serializer-ansi</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
