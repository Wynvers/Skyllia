    <name>Skyllia NMS v26_1</name>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>fr.euphyllia.skyllia</groupId>
            <artifactId>skyllia-api</artifactId>
